diff --git a/Telegram/Tests/channel_guard_policy_test.cpp b/Telegram/Tests/channel_guard_policy_test.cpp
new file mode 100644
index 0000000..84b4992
--- /dev/null
+++ b/Telegram/Tests/channel_guard_policy_test.cpp
@@ -0,0 +1,25 @@
+/*
+Standalone policy test. Run with:
+g++ -std=c++20 -ITelegram/SourceFiles Telegram/Tests/channel_guard_policy_test.cpp -o /tmp/channel_guard_policy_test
+*/
+#include "core/channel_guard.h"
+
+#include <cassert>
+#include <initializer_list>
+
+int main() {
+	using Window::ChannelGuard::ChatKind;
+	using Window::ChannelGuard::ShouldBlock;
+
+	for (const auto joined : { false, true }) {
+		for (const auto channels : { false, true }) {
+			for (const auto groups : { false, true }) {
+				assert(!ShouldBlock(ChatKind::User, joined, channels, groups));
+				assert(ShouldBlock(ChatKind::Channel, joined, channels, groups)
+					== (!joined && channels));
+				assert(ShouldBlock(ChatKind::Group, joined, channels, groups)
+					== (!joined && groups));
+			}
+		}
+	}
+}
diff --git a/configure_fork_windows.cmd b/configure_fork_windows.cmd
new file mode 100644
index 0000000..c295a74
--- /dev/null
+++ b/configure_fork_windows.cmd
@@ -0,0 +1,20 @@
+@echo off
+setlocal
+
+if not defined TDESKTOP_API_ID (
+    echo TDESKTOP_API_ID is missing. Set your own Telegram API ID first.
+    exit /b 1
+)
+if not defined TDESKTOP_API_HASH (
+    echo TDESKTOP_API_HASH is missing. Set your own Telegram API hash first.
+    exit /b 1
+)
+
+pushd "%~dp0Telegram" || exit /b 1
+call configure.bat x64 -D TDESKTOP_API_ID=%TDESKTOP_API_ID% -D TDESKTOP_API_HASH=%TDESKTOP_API_HASH% -D DESKTOP_APP_DISABLE_AUTOUPDATE=ON
+set "configure_result=%ERRORLEVEL%"
+popd
+
+if not "%configure_result%"=="0" exit /b %configure_result%
+
+echo Configuration ready. Build the Telegram project from out\Telegram.slnx.
